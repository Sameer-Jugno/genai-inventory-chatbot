# Copy this file to terraform.tfvars (gitignored) after you have AWS account access.
#   cp terraform.tfvars.example terraform.tfvars
#
# Values marked PLACEHOLDER must be confirmed against the real account/region
# before `terraform plan` / `apply`.

# --- Safe now (can keep as-is) ---
project_name = "inventory-planner"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"
public_subnet_cidrs = [
  "10.0.0.0/24",
  "10.0.1.0/24"
]
private_subnet_cidr = "10.0.10.0/24"

common_tags = {
  Project     = "inventory-planner"
  Environment = "dev"
  ManagedBy   = "terraform"
}

# --- PLACEHOLDERS: update after AWS account access ---

# Region where the stack will live. Must support Bedrock models you need.
aws_region = "us-east-1" # PLACEHOLDER

# Named profile from `aws configure` / SSO. Leave "" to use env vars / default chain.
aws_profile = "" # PLACEHOLDER — e.g. "inventory-planner-dev"

# Must be two real AZs in aws_region above.
availability_zones = [
  "us-east-1a", # PLACEHOLDER
  "us-east-1b"  # PLACEHOLDER
]

# External providers (used while Bedrock account access is blocked).
groq_model_id     = "llama-3.3-70b-versatile"
hf_embed_model_id = "BAAI/bge-large-en-v1.5"

# IAM + Phase 2/3 gates (keep false until lead grants iam:CreateRole).
enable_iam     = false
enable_phase2  = false
enable_phase3  = false

# Required when enable_phase3 = true (after docker push to ECR).
# chat_container_image = "ACCOUNT.dkr.ecr.us-east-1.amazonaws.com/inventory-planner-dev-chat-app:latest"

# Optional: your IAM user/role ARN so scripts/create_opensearch_index.py can run.
opensearch_bootstrap_principal_arns = [
  "arn:aws:iam::106295459576:user/inventory-planner-dev"
]
